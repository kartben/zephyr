config PULSE_IO_STM32_TIMER
	bool "STM32 timer Pulse IO driver"
	default y
	depends on DT_HAS_ST_STM32_PULSE_IO_ENABLED
	select USE_STM32_LL_TIM
	select DMA
	select CACHE_MANAGEMENT if DCACHE
	help
	  Enable the Pulse IO driver for STM32 timers. It transmits fixed-period
	  cells on timer channels in PWM mode, a DMA burst loading the duty
	  cycles of each period, and with RTIO receives the reply that follows
	  a transmit on a channel with a capture DMA.
