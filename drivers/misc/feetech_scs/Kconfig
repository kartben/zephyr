config FEETECH_SCS
	bool "Feetech SCS serial bus servo driver"
	default y
	depends on DT_HAS_FEETECH_SCS_BUS_ENABLED
	depends on SERIAL_SUPPORT_INTERRUPT
	select UART_INTERRUPT_DRIVEN
	help
	  Enable the driver for Feetech SCS series serial bus servos.

if FEETECH_SCS

config FEETECH_SCS_INIT_PRIORITY
	int "Feetech SCS driver initialization priority"
	default KERNEL_INIT_PRIORITY_DEVICE
	help
	  Initialization priority of the servo bus and servo devices. It
	  must be greater than or equal to the UART driver priority.

config FEETECH_SCS_RESPONSE_TIMEOUT_MS
	int "Servo response timeout in milliseconds"
	default 10
	help
	  Time to wait for a servo to answer a command before failing
	  with -ETIMEDOUT.

module = FEETECH_SCS
module-str = feetech_scs
source "subsys/logging/Kconfig.template.log_config"

endif # FEETECH_SCS
