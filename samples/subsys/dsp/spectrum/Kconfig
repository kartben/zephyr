source "samples/subsys/usb/common/Kconfig.sample_usbd"

source "Kconfig.zephyr"

config SAMPLE_SPECTRUM_DMIC
	bool "Capture microphone audio instead of generating tones"
	default n
	help
	  Read 16-bit mono PCM from the DMIC device selected by the dmic0 alias.
	  Enable CONFIG_AUDIO and CONFIG_AUDIO_DMIC as well.

config SAMPLE_SPECTRUM_USB_MIC
	bool "Expose the PCM source as a USB Audio Class 2 microphone"
	depends on USB_DEVICE_STACK_NEXT && USBD_AUDIO2_CLASS
	help
	  Send the PCM stream to the USB host as 16 kHz mono, 16-bit audio.
	  Requires the usb_mic.overlay devicetree overlay.

config SAMPLE_SPECTRUM_BATTERY
	bool "Show the battery charge in the header"
	default y
	depends on $(dt_alias_enabled,fuel-gauge0)
	select FUEL_GAUGE
	select SENSOR
	help
	  Read the state of charge from the fuel gauge selected by the
	  fuel-gauge0 alias every few seconds and draw it in the header.

config SAMPLE_SPECTRUM_HEADER_KEY
	bool "Toggle the header with the first user button"
	default y
	depends on $(dt_alias_enabled,sw0)
	select INPUT
	help
	  Hide or show the header when an INPUT_KEY_0 press is reported, so
	  the spectrum and waterfall can use the full screen height.
