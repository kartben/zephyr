#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/*
 * The high speed controller drives the board's USB-C connector, which is where
 * the phone attaches. SW4-8 selects USBHS for that connector.
 */
&usbhs {
	status = "okay";

	zephyr_uhc0: uhc {
		status = "okay";
	};
};

/* One controller, one role: the board enables the device side by default */
&zephyr_udc0 {
	status = "disabled";
};

/*
 * The connector is a device port until PD07 is driven high, which is also what
 * turns on the five volts the phone draws: in host mode J7 is fed from U18,
 * good for two amps. The board leaves port D off entirely.
 */
&ioportd {
	status = "okay";

	usbhs_host_mode {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/* The board leaves its buttons off, and the layout needs one */
&button0 {
	status = "okay";
};

/ {
	aliases {
		aa-longpress = &user_button_press;
		aa-i2s-out = &i2s0;
		aa-audio-codec = &audio_codec;
		dmic0 = &pdm2;
	};

	/*
	 * Holding the button switches the display between the phone alone and
	 * the phone beside the head unit's own GUI; a tap switches night mode.
	 */
	user_button_press: longpress {
		compatible = "zephyr,input-longpress";
		input = <&{/buttons}>;
		input-codes = <INPUT_KEY_0>;
		short-codes = <INPUT_KEY_N>;
		long-codes = <INPUT_KEY_S>;
		long-delay-ms = <700>;
	};
};

/*
 * The second core is not started, so its RAM is free. The two banks are
 * contiguous, which makes them one 1664 KB bank the decoder's pictures fit in.
 */
&sram0 {
	reg = <0x22000000 DT_SIZE_K(1664)>;
};

&sram1 {
	status = "disabled";
};

/*
 * The display controller reads the surface for every line it draws, while the
 * processor writes it once per frame. Holding it in the data cache makes the
 * processor read each line back before overwriting it, and that traffic is
 * bandwidth the controller needs: it underruns and drops a band of the
 * picture. Give it the top of the external RAM, uncached.
 */
&sdram1 {
	reg = <0x68000000 DT_SIZE_M(60)>;
};

/ {
	fb_sdram: memory@6bc00000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x6bc00000 DT_SIZE_M(4)>;
		zephyr,memory-region = "FB_SDRAM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};
};

/*
 * The phone's audio goes out through the board's codec and the head unit is
 * heard through MIC1. The board describes both but leaves them off, because
 * the codec's data lines are the parallel camera's; this sample has no camera,
 * so it takes them. J41 carries those two lines and is fitted by default.
 */
&pwm2 {
	status = "okay";
};

&audio_clock {
	status = "okay";
};

&i2s0 {
	status = "okay";
};

&audio_codec {
	status = "okay";
};

&pdm2 {
	status = "okay";
};
