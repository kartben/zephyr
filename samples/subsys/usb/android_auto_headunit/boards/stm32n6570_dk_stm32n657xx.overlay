#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/clock/stm32n6_clock.h>

/*
 * OTG2 drives the USB Type-A host connector (CN17). Its VBUS comes from an
 * STMPS2151 power switch enabled by PB9. The register values come from the
 * controller's own hardware configuration registers.
 */
zephyr_uhc0: &usbotg_hs2 {
	compatible = "st,stm32n6-hsotg", "snps,dwc2";
	/delete-property/ num-bidir-endpoints;
	/delete-property/ ram-size;
	/delete-property/ maximum-speed;
	num-in-eps = <9>;
	num-out-eps = <9>;
	ghwcfg1 = <0x00000000>;
	ghwcfg2 = <0x228fe052>;
	ghwcfg4 = <0xe2103e30>;
	vbus-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

/* Only OTG2 is used, and the Type-C port is the boot ROM's */
&usbotg_hs1 {
	status = "disabled";
};

/*
 * An M5Stack Unit Mini OLED on the Arduino header shows the next turn: SCL on
 * D15, SDA on D14, powered from 3V3. The shield of the same name is not used
 * because it claims zephyr,display, which belongs to the panel the video goes
 * to.
 */
/* Labelled so the two bus lines can be read back when nothing answers */
nav_bus_probe: &i2c1 {
	clocks = <&rcc STM32_CLOCK(APB1, 21)>,
		 <&rcc STM32_SRC_CKPER I2C1_SEL(1)>;
	pinctrl-0 = <&i2c1_scl_ph9 &i2c1_sda_pc1>;
	pinctrl-names = "default";
	status = "okay";

	nav_display: ssd1315@3c {
		compatible = "solomon,ssd1315";
		reg = <0x3c>;
		width = <72>;
		height = <40>;
		segment-offset = <28>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <39>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};

/ {
	aliases {
		aa-i2s-out = &sai1_a;
		aa-audio-codec = &wm8904;
		aa-nav-display = &nav_display;
	};
};
