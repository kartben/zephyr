mainmenu "Android Auto head unit sample"

menu "Android Auto head unit sample"

choice SAMPLE_AA_HU_TRANSPORT
	prompt "Phone transport"
	default SAMPLE_AA_HU_TRANSPORT_TCP

config SAMPLE_AA_HU_TRANSPORT_TCP
	bool "TCP"
	depends on NET_SOCKETS
	help
	  Connect to a phone that exposes the projection protocol on a TCP
	  port, which is how the companion accessory sample runs on native_sim.

config SAMPLE_AA_HU_TRANSPORT_USB_HOST
	bool "USB host"
	depends on USB_HOST_STACK
	help
	  Act as the USB host, switch an attached phone into Android Open
	  Accessory mode and carry the protocol over its bulk endpoints. The
	  board must be able to supply VBUS to the phone.

endchoice

if SAMPLE_AA_HU_TRANSPORT_USB_HOST

config SAMPLE_AA_HU_USBH_IN_XFER_SIZE
	int "Bulk IN transfer size (bytes)"
	default 4096
	help
	  Size of the buffer kept queued on the accessory's bulk IN endpoint.
	  Must be a multiple of the endpoint's maximum packet size and fit in
	  the host controller buffer pool.

config SAMPLE_AA_HU_USBH_OUT_XFER_SIZE
	int "Largest bulk OUT transfer (bytes)"
	default 4096
	help
	  Messages larger than this are written in several transfers.

config SAMPLE_AA_HU_USBH_RX_PIPE_SIZE
	int "Receive pipe size (bytes)"
	default 16384
	help
	  Buffers received data until the protocol thread consumes it. When it
	  fills up the transfer is parked and the phone is held off, so this
	  only has to absorb scheduling jitter.

config SAMPLE_AA_HU_USBH_WRITE_TIMEOUT_MS
	int "Bulk OUT timeout (ms)"
	default 2000
	help
	  A queued bulk transfer cannot be cancelled, so a write that times out
	  abandons its transfer instead of retrying it.

config SAMPLE_AA_HU_AOA_MANUFACTURER
	string "Accessory manufacturer string"
	default "Android"

config SAMPLE_AA_HU_AOA_MODEL
	string "Accessory model string"
	default "Android Auto"
	help
	  A phone only starts projection when the manufacturer and model are
	  the exact strings Android Auto looks for.

config SAMPLE_AA_HU_AOA_DESCRIPTION
	string "Accessory description string"
	default "Android Auto"

config SAMPLE_AA_HU_AOA_VERSION
	string "Accessory version string"
	default "1.0"

config SAMPLE_AA_HU_AOA_URI
	string "Accessory URI string"
	default "https://www.zephyrproject.org"

config SAMPLE_AA_HU_AOA_SERIAL
	string "Accessory serial string"
	default "0000000000000001"

endif # SAMPLE_AA_HU_TRANSPORT_USB_HOST

config SAMPLE_AA_HU_TCP_HOST
	string "Phone address"
	depends on SAMPLE_AA_HU_TRANSPORT_TCP
	default "127.0.0.1"

config SAMPLE_AA_HU_TCP_PORT
	int "Phone port"
	depends on SAMPLE_AA_HU_TRANSPORT_TCP
	default 5277
	range 1 65535

config SAMPLE_AA_HU_TX_CHUNK_SIZE
	int "Largest message fragment sent (bytes)"
	default 16384
	range 1024 16384

config SAMPLE_AA_HU_RX_FRAME_SIZE
	int "Receive frame buffer size (bytes)"
	default 8256
	help
	  Must hold one frame's payload. A phone packs several TLS records of
	  video into a single frame, so a real one needs far more than the
	  companion accessory sample.

config SAMPLE_AA_HU_RX_MSG_SIZE
	int "Reassembly buffer for fragmented messages (bytes)"
	default 65536
	help
	  Media messages carry a whole H.264 access unit, so this must hold the
	  largest picture the phone sends in one message. A real phone's frames
	  are compact; the companion accessory sample's I_PCM key frames are
	  large (about 580 KB at 800x480), so its transport overrides this.

config SAMPLE_AA_HU_TEST_PATTERN
	bool "Show colour bars at startup"
	help
	  Fill the framebuffer with colour bars before the phone connects, to
	  check the panel and the pixel format.

config SAMPLE_AA_HU_H264
	bool "Decode the phone's H.264 stream"
	help
	  Decode the baseline H.264 a phone streams, rather than only the
	  companion accessory sample's I_PCM pictures. Needs a checkout of the
	  h264bsd decoder, which is not part of Zephyr.

config SAMPLE_AA_HU_H264BSD_PATH
	string "Path to an h264bsd checkout"
	depends on SAMPLE_AA_HU_H264
	help
	  Directory holding the decoder's src/ directory.

config SAMPLE_AA_HU_LTDC_YUV
	bool "Let the display controller convert the decoded pictures"
	depends on SAMPLE_AA_HU_H264 && STM32_LTDC_YUV
	default y if STM32_LTDC_YUV
	help
	  Interleave the decoder's planar YUV420 pictures into packed YUYV
	  buffers. The display controller converts them to RGB during scanout,
	  avoiding software color conversion. Packed YUV422 avoids the STM32N6
	  planar YUV420 silicon limitation (ES0620, section 2.7.1).

config SAMPLE_AA_HU_YUV_BUFFERS_SECTION
	string "Memory section for YUV display buffers"
	depends on SAMPLE_AA_HU_LTDC_YUV
	default "AXISRAM1" if BOARD_STM32N6570_DK
	default SAMPLE_AA_HU_BUFFERS_SECTION if SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	default ".bss"
	help
	  Linker section for the two packed display buffers. Internal SRAM
	  avoids external-memory traffic for packing and display scanout.
	  The section must hold four bytes per pixel at the video resolution.

config SAMPLE_AA_HU_H264_HEAP_SIZE
	int "Decoder heap (bytes)"
	depends on SAMPLE_AA_HU_H264
	default 8388608
	help
	  Holds the decoder's reference pictures, several times the frame size.

config SAMPLE_AA_HU_NAL_SCRATCH_SIZE
	int "Decoder NAL scratch buffer (bytes)"
	default 40960
	help
	  Must hold the largest NAL unit; the companion encoder slices a picture
	  into macroblock rows to keep NAL units small.

config SAMPLE_AA_HU_MAX_UNACKED
	int "Media messages the phone may send without an acknowledgment"
	default 1
	range 1 16

config SAMPLE_AA_HU_PROTO_MINOR
	int "Protocol minor version announced to the phone"
	default 1

config SAMPLE_AA_HU_NAME
	string "Head unit name announced in service discovery"
	default "Zephyr head unit"

config SAMPLE_AA_HU_RX_THREAD_PRIORITY
	int "Receive thread priority"
	default 5

config SAMPLE_AA_HU_RX_STACK_SIZE
	int "Receive thread stack size"
	default 8192 if 64BIT
	default 6144

config SAMPLE_AA_HU_CERT_FILE
	string "Certificate presented to the phone (PEM)"
	default "certs/hu_cert.pem"
	help
	  A phone verifies this certificate against Google's certificate
	  authority. The bundled one is self-signed and only works with phones
	  that skip that check, such as the companion accessory sample.

config SAMPLE_AA_HU_KEY_FILE
	string "Private key of the certificate (PEM)"
	default "certs/hu_key.pem"

config SAMPLE_AA_HU_TLS_DEBUG_LEVEL
	int "Mbed TLS debug threshold"
	depends on MBEDTLS_DEBUG
	default 1
	range 0 5

choice SAMPLE_AA_HU_VIDEO_RESOLUTION
	prompt "Video resolution offered to the phone"
	default SAMPLE_AA_HU_VIDEO_800X480

config SAMPLE_AA_HU_VIDEO_800X480
	bool "800x480"

config SAMPLE_AA_HU_VIDEO_1280X720
	bool "1280x720"

endchoice

config SAMPLE_AA_HU_VIDEO_WIDTH
	int
	default 1280 if SAMPLE_AA_HU_VIDEO_1280X720
	default 800

config SAMPLE_AA_HU_VIDEO_HEIGHT
	int
	default 720 if SAMPLE_AA_HU_VIDEO_1280X720
	default 480

config SAMPLE_AA_HU_DEMO_TAP
	bool "Periodically tap the phone screen"
	help
	  Forward a synthetic touch at a fixed point every few seconds, to
	  exercise the input channel without a physical touch screen.

config SAMPLE_AA_HU_DEMO_TAP_X
	int "Demo tap X"
	depends on SAMPLE_AA_HU_DEMO_TAP
	default 400

config SAMPLE_AA_HU_DEMO_TAP_Y
	int "Demo tap Y"
	depends on SAMPLE_AA_HU_DEMO_TAP
	default 147

config SAMPLE_AA_HU_DEMO_TAP_INTERVAL_MS
	int "Demo tap interval (ms)"
	depends on SAMPLE_AA_HU_DEMO_TAP
	default 2000

config SAMPLE_AA_HU_MIC_CLK_MIN_HZ
	int "Lowest microphone clock frequency (Hz)"
	default 1000000

config SAMPLE_AA_HU_MIC_CLK_MAX_HZ
	int "Highest microphone clock frequency (Hz)"
	default 3500000
	help
	  The driver clocks the microphone as fast as this window allows. A PDM
	  microphone with several operating modes selects one by clock
	  frequency and its sensitivity differs between them, so narrow the
	  window to the mode the part should be run in.

config SAMPLE_AA_HU_MIC_LEVEL_LOG
	bool "Report the level of the captured audio"
	help
	  Log the peak and RMS level of the captured samples once a second, to
	  tell a microphone that is too quiet from one that clips.

config SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	bool "Place the large buffers in external RAM"
	default y if ESP_SPIRAM
	help
	  The framebuffer and the message reassembly buffer are far larger than
	  the internal RAM of most boards that can act as a host.

config SAMPLE_AA_HU_BUFFERS_SECTION
	string "Linker section for the large buffers"
	depends on SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	default ".ext_ram.bss" if ESP_SPIRAM
	default "PSRAM"

config SAMPLE_AA_HU_FB_DUMP
	bool "Dump decoded pictures to a host file"
	depends on ARCH_POSIX
	help
	  Append every decoded RGB565 picture to a host file so that the stream
	  can be inspected without a display.

config SAMPLE_AA_HU_FB_DUMP_PATH
	string "Framebuffer dump file"
	depends on SAMPLE_AA_HU_FB_DUMP
	default "hu_frames.rgb565"

module = SAMPLE_AA_HU
module-str = Android Auto head unit sample
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
