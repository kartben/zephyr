mainmenu "Android Auto head unit sample"

menu "Android Auto head unit sample"

choice SAMPLE_AA_HU_TRANSPORT
	prompt "Phone transport"
	default SAMPLE_AA_HU_TRANSPORT_TCP

config SAMPLE_AA_HU_TRANSPORT_TCP
	bool "TCP"
	depends on NET_SOCKETS
	help
	  Connect to a phone that exposes the projection protocol on a TCP
	  port, which is how the companion accessory sample runs on native_sim.

config SAMPLE_AA_HU_TRANSPORT_USB_HOST
	bool "USB host"
	depends on USB_HOST_STACK
	help
	  Act as the USB host, switch an attached phone into Android Open
	  Accessory mode and carry the protocol over its bulk endpoints. The
	  board must be able to supply VBUS to the phone.

config SAMPLE_AA_HU_TRANSPORT_NONE
	bool "None"
	help
	  Build with no way to reach a phone, for a board that has neither a
	  network nor a USB host port and for the emulators. The head unit
	  brings up its display and its own GUI and stays in its link down
	  state; SAMPLE_AA_HU_DEMO_CLIP is what then gives it something to
	  show.

endchoice

if SAMPLE_AA_HU_TRANSPORT_USB_HOST

config SAMPLE_AA_HU_USBH_IN_XFER_SIZE
	int "Bulk IN transfer size (bytes)"
	default 4096
	help
	  Size of the buffer kept queued on the accessory's bulk IN endpoint.
	  Must be a multiple of the endpoint's maximum packet size and fit in
	  the host controller buffer pool.

config SAMPLE_AA_HU_USBH_OUT_XFER_SIZE
	int "Largest bulk OUT transfer (bytes)"
	default 4096
	help
	  Messages larger than this are written in several transfers.

config SAMPLE_AA_HU_USBH_RX_PIPE_SIZE
	int "Receive pipe size (bytes)"
	default 16384
	help
	  Buffers received data until the protocol thread consumes it. When it
	  fills up the transfer is parked and the phone is held off, so this
	  only has to absorb scheduling jitter.

config SAMPLE_AA_HU_USBH_WRITE_TIMEOUT_MS
	int "Bulk OUT timeout (ms)"
	default 2000
	help
	  A queued bulk transfer cannot be cancelled, so a write that times out
	  abandons its transfer instead of retrying it.

config SAMPLE_AA_HU_AOA_MANUFACTURER
	string "Accessory manufacturer string"
	default "Android"

config SAMPLE_AA_HU_AOA_MODEL
	string "Accessory model string"
	default "Android Auto"
	help
	  A phone only starts projection when the manufacturer and model are
	  the exact strings Android Auto looks for.

config SAMPLE_AA_HU_AOA_DESCRIPTION
	string "Accessory description string"
	default "Android Auto"

config SAMPLE_AA_HU_AOA_VERSION
	string "Accessory version string"
	default "1.0"

config SAMPLE_AA_HU_AOA_URI
	string "Accessory URI string"
	default "https://www.zephyrproject.org"

config SAMPLE_AA_HU_AOA_SERIAL
	string "Accessory serial string"
	default "0000000000000001"

endif # SAMPLE_AA_HU_TRANSPORT_USB_HOST

config SAMPLE_AA_HU_TCP_HOST
	string "Phone address"
	depends on SAMPLE_AA_HU_TRANSPORT_TCP
	default "127.0.0.1"

config SAMPLE_AA_HU_TCP_PORT
	int "Phone port"
	depends on SAMPLE_AA_HU_TRANSPORT_TCP
	default 5277
	range 1 65535

config SAMPLE_AA_HU_TX_CHUNK_SIZE
	int "Largest message fragment sent (bytes)"
	default 16384
	range 1024 16384

config SAMPLE_AA_HU_RX_FRAME_SIZE
	int "Receive frame buffer size (bytes)"
	default 8256
	help
	  Must hold one frame's payload. A phone packs several TLS records of
	  video into a single frame, so a real one needs far more than the
	  companion accessory sample.

config SAMPLE_AA_HU_RX_MSG_SIZE
	int "Reassembly buffer for fragmented messages (bytes)"
	default 65536
	help
	  Media messages carry a whole H.264 access unit, so this must hold the
	  largest picture the phone sends in one message. A real phone's frames
	  are compact; the companion accessory sample's I_PCM key frames are
	  large (about 580 KB at 800x480), so its transport overrides this.

config SAMPLE_AA_HU_TEST_PATTERN
	bool "Show colour bars at startup"
	help
	  Fill the framebuffer with colour bars before the phone connects, to
	  check the panel and the pixel format.

config SAMPLE_AA_HU_H264
	bool "Decode the phone's H.264 stream"
	depends on ZEPHYR_H264BSD_MODULE
	select H264BSD
	help
	  Decode the baseline H.264 a phone streams, rather than only the
	  companion accessory sample's I_PCM pictures. The decoder is the
	  h264bsd module, so this needs a west manifest that carries it.

# The decoder's reference pictures are large and this sample places them
# itself, in a bank chosen per board.
configdefault H264BSD_MALLOC
	default "aa_h264_malloc" if SAMPLE_AA_HU_H264

configdefault H264BSD_FREE
	default "aa_h264_free" if SAMPLE_AA_HU_H264

config SAMPLE_AA_HU_LTDC_YUV
	bool "Let the display controller convert the decoded pictures"
	depends on SAMPLE_AA_HU_H264 && STM32_LTDC_YUV
	default y if STM32_LTDC_YUV
	help
	  Interleave the decoder's planar YUV420 pictures into packed YUYV
	  buffers. The display controller converts them to RGB during scanout,
	  avoiding software color conversion. Packed YUV422 avoids the STM32N6
	  planar YUV420 silicon limitation (ES0620, section 2.7.1).

config SAMPLE_AA_HU_DISPLAY_ARGB8888
	bool "Compose into a word per pixel"
	depends on SAMPLE_AA_HU_H264 && !SAMPLE_AA_HU_LTDC_YUV
	default y if QEMU_RAMFB_DISPLAY
	help
	  Convert the decoder's pictures to ARGB8888 rather than RGB565, for a
	  display that scans nothing narrower. The QEMU ramfb the browser
	  emulator paints is one: it carries a DRM format code and only
	  answers for AR24. The bundled I_PCM decoder writes RGB565 pixels
	  straight to the surface, so this needs the full decoder, whose
	  pictures are composed on the way.

config SAMPLE_AA_HU_YUV_BUFFERS_SECTION
	string "Memory section for YUV display buffers"
	depends on SAMPLE_AA_HU_LTDC_YUV
	default "AXISRAM1" if BOARD_STM32N6570_DK
	default SAMPLE_AA_HU_BUFFERS_SECTION if SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	default ".bss"
	help
	  Linker section for the two packed display buffers. Internal SRAM
	  avoids external-memory traffic for packing and display scanout.
	  The section must hold four bytes per pixel at the video resolution.

config SAMPLE_AA_HU_VIDEO_PROFILE
	bool "Report how long a picture takes"
	depends on SAMPLE_AA_HU_H264
	help
	  Log the time a picture spends in the decoder and the time it spends
	  being converted and copied to the display, averaged over the last
	  couple of seconds. The two answer different questions: the first is
	  the decoder's, the second is the sample's own.

config SAMPLE_AA_HU_H264_HEAP_STATS
	bool "Report how much of the decoder heap is used"
	depends on SAMPLE_AA_HU_H264
	select SYS_HEAP_RUNTIME_STATS
	help
	  Log the most the decoder has ever held at once, so the heap can be
	  sized from what a phone actually asks for rather than guessed at.

config SAMPLE_AA_HU_H264_HEAP_SIZE
	int "Decoder heap (bytes)"
	depends on SAMPLE_AA_HU_H264
	default 4194304
	help
	  Holds the decoder's reference pictures, several times the frame size.
	  A phone asks for as many as its stream needs, not as many as the
	  level allows, so this is sized for the level rather than for one
	  device: 800x480 at level 3.1 tops out near 3.5 MB. Enable
	  SAMPLE_AA_HU_H264_HEAP_STATS to see what a given phone uses.

config SAMPLE_AA_HU_H264_HEAP_SECTION
	string "Linker section for the decoder heap"
	depends on SAMPLE_AA_HU_H264
	default SAMPLE_AA_HU_BUFFERS_SECTION if SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	default ".bss"
	help
	  Internal RAM spares the decoder the miss latency of external memory
	  when it reads reference pictures, at the cost of holding the whole
	  arena there.

config SAMPLE_AA_HU_H264_HEAP_FALLBACK
	bool "Keep a second decoder heap for streams the first cannot hold"
	depends on SAMPLE_AA_HU_H264 && SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	help
	  A heap sized for one resolution and reference count has no room to
	  spare, and a stream that overruns it stops the video. Enable this
	  where the first heap is the fast, tight one: the decoder moves to a
	  larger heap in external RAM and keeps decoding, more slowly.

config SAMPLE_AA_HU_H264_HEAP_FALLBACK_SIZE
	int "Fallback decoder heap (bytes)"
	depends on SAMPLE_AA_HU_H264_HEAP_FALLBACK
	default 4194304

config SAMPLE_AA_HU_H264_HEAP_FALLBACK_SECTION
	string "Linker section for the fallback decoder heap"
	depends on SAMPLE_AA_HU_H264_HEAP_FALLBACK
	default SAMPLE_AA_HU_BUFFERS_SECTION

config SAMPLE_AA_HU_NAL_SCRATCH_SIZE
	int "Decoder NAL scratch buffer (bytes)"
	default 40960
	help
	  Must hold the largest NAL unit; the companion encoder slices a picture
	  into macroblock rows to keep NAL units small.

config SAMPLE_AA_HU_DEMO_CLIP
	bool "Play a clip of the sample's own instead of connecting to a phone"
	depends on SAMPLE_AA_HU_H264
	help
	  Decode the navigation clip built into the image, over and over, and
	  leave the transport alone. Everything after the decoder is what a
	  phone's pictures go through, so the display, the layout and the head
	  unit's own GUI can be seen where no phone can be attached: an
	  emulator, or a board without a USB host port. The clip is
	  src/aa_demo_clip.h, which scripts/make_demo_clip.py writes.

config SAMPLE_AA_HU_DEMO_CLIP_STACK_SIZE
	int "Clip player thread stack size"
	depends on SAMPLE_AA_HU_DEMO_CLIP
	default 4096

config SAMPLE_AA_HU_MAX_UNACKED
	int "Media messages the phone may send without an acknowledgment"
	default 1
	range 1 16

config SAMPLE_AA_HU_NIGHT_BUTTON
	bool "Switch night mode with the board's user button"
	depends on INPUT
	depends on $(dt_alias_enabled,sw0)
	default y
	help
	  Report the head unit as having gone dark, and light again, each time
	  the button behind the sw0 alias is pressed, so that the phone can be
	  made to switch between its day and night themes without a light
	  sensor to cover.

config SAMPLE_AA_HU_SPLIT_SCREEN
	bool "Share the display with a GUI of the head unit's own"
	depends on SAMPLE_AA_HU_H264
	default y
	select THREAD_MONITOR
	select THREAD_NAME
	select THREAD_RUNTIME_STATS
	select CHARACTER_FRAMEBUFFER
	help
	  Offer the phone the whole display as before, but scale its picture
	  into the top left quarter and hand the right half to a GUI of the
	  head unit's own when the layout is switched. The bundled I_PCM
	  decoder writes its pictures straight to the framebuffer at their own
	  size, so this needs the H.264 decoder, which hands its pictures over
	  to be composed. The GUI charts what each thread is doing with the
	  processor, which is what the runtime statistics are for, and labels
	  it with the character framebuffer's smallest font.

config SAMPLE_AA_HU_SPLIT_BUTTON
	bool "Switch the display layout by holding the user button"
	depends on SAMPLE_AA_HU_SPLIT_SCREEN && INPUT
	depends on $(dt_alias_enabled,aa-longpress)
	default y
	help
	  Switch between the two layouts on every long press reported by the
	  input longpress device behind the "aa-longpress" alias, leaving the
	  short press of the same button to switch night mode.

config SAMPLE_AA_HU_SPLIT_ANIM_MS
	int "Time the layout takes to change (ms)"
	depends on SAMPLE_AA_HU_SPLIT_SCREEN
	default 400
	range 1 5000
	help
	  The picture is scaled to whatever size it has reached while the
	  layout is moving, which neither of the two fast paths covers, so a
	  long animation is a long time spent in the general one.

config SAMPLE_AA_HU_GUI_CANVAS_SECTION
	string "Memory section for the GUI canvas"
	depends on SAMPLE_AA_HU_SPLIT_SCREEN
	default SAMPLE_AA_HU_BUFFERS_SECTION if SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	default ".bss"
	help
	  Linker section for the RGB565 canvas the GUI is drawn into, which is
	  half the display wide and all of it tall. Only what has changed is
	  read out of it per frame, so external memory costs little.

config SAMPLE_AA_HU_GUI_PERIOD_MS
	int "Time between GUI updates (ms)"
	depends on SAMPLE_AA_HU_SPLIT_SCREEN
	default 33
	range 5 1000
	help
	  How often the GUI is redrawn, and so also the fastest it drives the
	  display when the phone is sending nothing.

config SAMPLE_AA_HU_GUI_IDLE_MS
	int "Silence from the phone that hands the display to the GUI (ms)"
	depends on SAMPLE_AA_HU_SPLIT_SCREEN
	default 1000
	help
	  A picture from the phone carries the GUI to the display with it, so
	  the GUI only has to drive the display itself once the phone has gone
	  quiet for this long. The video area goes black when it does.

config SAMPLE_AA_HU_GUI_STACK_SIZE
	int "GUI thread stack size"
	depends on SAMPLE_AA_HU_SPLIT_SCREEN
	default 2048

config SAMPLE_AA_HU_GUI_THREAD_PRIORITY
	int "GUI thread priority"
	depends on SAMPLE_AA_HU_SPLIT_SCREEN
	default 7
	help
	  Kept below the receive thread so that redrawing the GUI never costs
	  the video a frame.

config SAMPLE_AA_HU_TOF_NIGHT
	bool "Drive night mode from a time-of-flight ranger"
	depends on SENSOR && SENSOR_ASYNC_API
	help
	  Report the ranger under the "aa-tof" alias as the head unit's light
	  level, so that covering it switches the phone to its night theme.
	  The board has no light sensor and this makes the sensor channel do
	  something visible without a vehicle bus behind it.

config SAMPLE_AA_HU_TOF_NEAR_MM
	int "Distance below which it counts as dark (mm)"
	depends on SAMPLE_AA_HU_TOF_NIGHT
	default 300

config SAMPLE_AA_HU_TOF_FAR_MM
	int "Distance above which it counts as light again (mm)"
	depends on SAMPLE_AA_HU_TOF_NIGHT
	default 500
	help
	  Kept above the near threshold so that a hand at the boundary does
	  not make the phone flash between its themes.

config SAMPLE_AA_HU_TOF_PERIOD_MS
	int "Time between readings (ms)"
	depends on SAMPLE_AA_HU_TOF_NIGHT
	default 500

config SAMPLE_AA_HU_TOF_RATE_HZ
	int "Ranging frequency asked of the sensor (Hz)"
	depends on SAMPLE_AA_HU_TOF_NIGHT
	default 15

config SAMPLE_AA_HU_TOF_STACK_SIZE
	int "Ranger thread stack size"
	depends on SAMPLE_AA_HU_TOF_NIGHT
	default 2048

config SAMPLE_AA_HU_TOF_THREAD_PRIORITY
	int "Ranger thread priority"
	depends on SAMPLE_AA_HU_TOF_NIGHT
	default 10

config SAMPLE_AA_HU_TOUCH_DRAG_MIN_MS
	int "Shortest gap between reports of a finger being dragged (ms)"
	default 33
	help
	  The screen reports a held finger far faster than the phone needs it,
	  and every report is a USB transfer that the video acknowledgements
	  queue behind, so a finger dragged across the screen costs frames.
	  Thirty-three milliseconds matches the thirty frames a second the
	  video is sent at, beyond which the extra reports buy nothing.

config SAMPLE_AA_HU_PROTO_MINOR
	int "Protocol minor version announced to the phone"
	default 1

config SAMPLE_AA_HU_NAME
	string "Head unit name announced in service discovery"
	default "Zephyr head unit"

config SAMPLE_AA_HU_RX_THREAD_PRIORITY
	int "Receive thread priority"
	default 5

config SAMPLE_AA_HU_USBH_RX_PIPE_SECTION
	string "Memory section for the USB receive pipe"
	depends on SAMPLE_AA_HU_TRANSPORT_USB_HOST
	default ".bss"
	help
	  The pipe carrying what the phone sends is only touched by the
	  processor, so a board short of image RAM can put it elsewhere.

config SAMPLE_AA_HU_RX_STACK_SIZE
	int "Receive thread stack size"
	default 8192 if 64BIT
	default 6144

config SAMPLE_AA_HU_CERT_FILE
	string "Certificate presented to the phone (PEM)"
	default "certs/hu_cert.pem"
	help
	  A phone verifies this certificate against Google's certificate
	  authority. The bundled one is self-signed and only works with phones
	  that skip that check, such as the companion accessory sample.

config SAMPLE_AA_HU_KEY_FILE
	string "Private key of the certificate (PEM)"
	default "certs/hu_key.pem"

config SAMPLE_AA_HU_TLS_DEBUG_LEVEL
	int "Mbed TLS debug threshold"
	depends on MBEDTLS_DEBUG
	default 1
	range 0 5

choice SAMPLE_AA_HU_VIDEO_RESOLUTION
	prompt "Video resolution offered to the phone"
	default SAMPLE_AA_HU_VIDEO_800X480

config SAMPLE_AA_HU_VIDEO_800X480
	bool "800x480"

config SAMPLE_AA_HU_VIDEO_1280X720
	bool "1280x720"

endchoice

choice SAMPLE_AA_HU_VIDEO_RATE
	prompt "Frame rate offered to the phone"
	default SAMPLE_AA_HU_VIDEO_30FPS
	help
	  The phone sends at whatever rate it is offered, and every picture
	  costs the receive thread a decode, a colour conversion and a copy to
	  the display. Thirty is what the sample can hold at 800x480 with room
	  to spare; sixty doubles all of it for a stream the eye barely tells
	  apart at this size.

config SAMPLE_AA_HU_VIDEO_30FPS
	bool "30"

config SAMPLE_AA_HU_VIDEO_60FPS
	bool "60"

endchoice

config SAMPLE_AA_HU_VIDEO_WIDTH
	int
	default 1280 if SAMPLE_AA_HU_VIDEO_1280X720
	default 800

config SAMPLE_AA_HU_VIDEO_HEIGHT
	int
	default 720 if SAMPLE_AA_HU_VIDEO_1280X720
	default 480

config SAMPLE_AA_HU_DEMO_TAP
	bool "Periodically tap the phone screen"
	help
	  Forward a synthetic touch at a fixed point every few seconds, to
	  exercise the input channel without a physical touch screen.

config SAMPLE_AA_HU_DEMO_TAP_X
	int "Demo tap X"
	depends on SAMPLE_AA_HU_DEMO_TAP
	default 400

config SAMPLE_AA_HU_DEMO_TAP_Y
	int "Demo tap Y"
	depends on SAMPLE_AA_HU_DEMO_TAP
	default 147

config SAMPLE_AA_HU_DEMO_TAP_INTERVAL_MS
	int "Demo tap interval (ms)"
	depends on SAMPLE_AA_HU_DEMO_TAP
	default 2000

config SAMPLE_AA_HU_MIC_CLK_MIN_HZ
	int "Lowest microphone clock frequency (Hz)"
	default 1000000

config SAMPLE_AA_HU_MIC_CLK_MAX_HZ
	int "Highest microphone clock frequency (Hz)"
	default 3500000
	help
	  The driver clocks the microphone as fast as this window allows. A PDM
	  microphone with several operating modes selects one by clock
	  frequency and its sensitivity differs between them, so narrow the
	  window to the mode the part should be run in.

config SAMPLE_AA_HU_MIC_GAIN_DB
	int "Microphone gain (dB)"
	default 24
	range 0 48
	help
	  Applied to the microphone's samples on the way to the phone, in
	  steps of six decibels. Zero sends the microphone's own range as it
	  is, which leaves speech far below full scale on most parts. Raise it
	  until the level report shows peaks near full scale without clipping.

config SAMPLE_AA_HU_AUDIO_MAX_UNACKED
	int "Audio messages the phone may send without an acknowledgment"
	default 16
	range 1 64
	help
	  A phone waits for this many media messages to be answered before it
	  stops sending, and drops what it cannot send. One message is twenty
	  milliseconds of sound, so a small number caps the stream at whatever
	  the round trip to the head unit allows.

config SAMPLE_AA_HU_PLAYBACK
	def_bool $(dt_alias_enabled,aa-i2s-out)
	depends on I2S && AUDIO_CODEC
	select RING_BUFFER
	select RING_BUFFER_LARGE
	help
	  The half-second stereo media queue holds 96000 bytes and requires
	  32-bit ring-buffer indices.

config SAMPLE_AA_HU_PLAY_VOLUME_DB
	int "Output volume (dB)"
	default 0
	range -57 6
	help
	  Headphone amplifier gain. The codec driver leaves it twelve decibels
	  down, which is quiet for a head unit driving a headset.

config SAMPLE_AA_HU_PLAY_TEST_TONE
	bool "Play a tone of the head unit's own"
	help
	  Mix a steady tone into the output whatever the phone is doing, to
	  tell an output that is not working from a phone that is not sending
	  anything.

config SAMPLE_AA_HU_PLAY_LEVEL_LOG
	bool "Report the level of the played audio"
	help
	  Log the peak level of the mixed output once a second, to tell a
	  phone that is sending quiet samples from an output that is turned
	  down.

config SAMPLE_AA_HU_PLAY_BUFFERS_SECTION
	string "Memory section for the audio queues"
	default "PSRAM" if BOARD_STM32N6570_DK
	default ".bss"
	help
	  Linker section for the half second of samples queued per audio
	  channel. Only the blocks handed to the output itself have to be
	  reachable by the controller, so these can sit in external memory.

config SAMPLE_AA_HU_TX_BUFFERS_SECTION
	string "Memory section for the transmit buffers"
	default "PSRAM" if BOARD_STM32N6570_DK
	default ".bss"
	help
	  Linker section for the buffers a message is assembled and encrypted
	  in. They are as large as the largest fragment sent twice over, which
	  is more than a board also decoding video can spare internally. Only
	  small messages are assembled often, so external memory costs little.

config SAMPLE_AA_HU_MIC_BUFFERS_SECTION
	string "Memory section for the microphone blocks"
	default "AXISRAM1" if BOARD_STM32N6570_DK
	default ".bss"
	help
	  Linker section for the blocks the microphone driver fills. Half a
	  second of them does not fit the internal RAM of a board that is also
	  decoding video into it.

config SAMPLE_AA_HU_MIC_LEVEL_LOG
	bool "Report the level of the captured audio"
	help
	  Log the peak and RMS level of the captured samples once a second, to
	  tell a microphone that is too quiet from one that clips.

config SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	bool "Place the large buffers in external RAM"
	default y if ESP_SPIRAM
	help
	  The framebuffer and the message reassembly buffer are far larger than
	  the internal RAM of most boards that can act as a host.

config SAMPLE_AA_HU_BUFFERS_SECTION
	string "Linker section for the large buffers"
	depends on SAMPLE_AA_HU_BUFFERS_IN_EXT_RAM
	default ".ext_ram.bss" if ESP_SPIRAM
	default "PSRAM"

config SAMPLE_AA_HU_FB_DUMP
	bool "Dump decoded pictures to a host file"
	depends on ARCH_POSIX
	depends on !SAMPLE_AA_HU_DISPLAY_ARGB8888
	help
	  Append every decoded RGB565 picture to a host file so that the stream
	  can be inspected without a display.

config SAMPLE_AA_HU_FB_DUMP_PATH
	string "Framebuffer dump file"
	depends on SAMPLE_AA_HU_FB_DUMP
	default "hu_frames.rgb565"

module = SAMPLE_AA_HU
module-str = Android Auto head unit sample
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
