#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

/* Receiver on the side headers: GPIO17 (TX) and GPIO18 (RX) */
&pinctrl {
	uart1_crsf: uart1_crsf {
		group1 {
			pinmux = <UART1_TX_GPIO17>;
			output-high;
		};

		group2 {
			pinmux = <UART1_RX_GPIO18>;
			bias-pull-up;
		};
	};
};

crsf_uart: &uart1 {
	pinctrl-0 = <&uart1_crsf>;
	pinctrl-names = "default";
};

#include "crsf_receiver.dtsi"
