config USBD_CDC_NCM_CLASS
	bool "USB CDC NCM implementation"
	default y
	depends on NET_L2_ETHERNET
	depends on DT_HAS_ZEPHYR_CDC_NCM_ETHERNET_ENABLED
	help
	  USB CDC Network Control Model (NCM) implementation

if USBD_CDC_NCM_CLASS

config USBD_CDC_NCM_MAX_DGRAM_PER_NTB
	int "Max number of received datagrams per NTB"
	range 0 $(UINT16_MAX)
	default 2
	help
	  How many datagrams we are able to receive per NTB.

config USBD_CDC_NCM_RX_BUF_COUNT
	int "Number of receive buffers per CDC NCM instance"
	range 1 16
	default 2
	help
	  Number of buffers queued on the bulk OUT endpoint of a CDC NCM
	  instance. The host is NAKed whenever the endpoint runs out of
	  buffers, which with a single buffer happens on every received NTB
	  because the endpoint stays empty until the class has unpacked the
	  NTB and passed its datagrams to the network stack. Each buffer costs
	  CDC_NCM_RECV_NTB_MAX_SIZE bytes of RAM.

config USBD_CDC_NCM_TX_BUF_COUNT
	int "Number of transmit buffers per CDC NCM instance"
	range 1 16
	default 2
	help
	  Number of NTBs that can be in flight towards the host at once. With a
	  single buffer the network stack has to wait for an NTB to reach the
	  host before it can prepare the next one, which puts a full interrupt
	  to thread round trip between two NTBs. Each buffer costs
	  CDC_NCM_SEND_NTB_MAX_SIZE bytes of RAM.

config USBD_CDC_NCM_SUPPORT_NTB32
	bool "Support NTB32 format"
	help
	  Enable support for NTB32 format which allows larger
	  packet sizes.

module = USBD_CDC_NCM
module-str = usbd cdc_ncm
source "subsys/logging/Kconfig.template.log_config"

endif
