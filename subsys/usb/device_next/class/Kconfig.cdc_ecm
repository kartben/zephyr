config USBD_CDC_ECM_CLASS
	bool "USB CDC ECM implementation"
	default y
	depends on NET_L2_ETHERNET
	depends on DT_HAS_ZEPHYR_CDC_ECM_ETHERNET_ENABLED
	help
	  USB CDC Ethernet Control Model (ECM) implementation"

if USBD_CDC_ECM_CLASS

config USBD_CDC_ECM_RX_BUF_COUNT
	int "Number of receive buffers per CDC ECM instance"
	range 1 16
	default 2
	help
	  Number of buffers queued on the bulk OUT endpoint of a CDC ECM
	  instance. The host is NAKed whenever the endpoint runs out of
	  buffers, which with a single buffer happens on every received frame
	  because the endpoint stays empty until the class has passed the
	  frame to the network stack. Each buffer costs NET_ETH_MAX_FRAME_SIZE
	  bytes of RAM.

config USBD_CDC_ECM_TX_BUF_COUNT
	int "Number of transmit buffers per CDC ECM instance"
	range 1 16
	default 2
	help
	  Number of frames that can be in flight towards the host at once. With
	  a single buffer the network stack has to wait for a frame to reach
	  the host before it can prepare the next one, which puts a full
	  interrupt to thread round trip between two frames. Each buffer costs
	  NET_ETH_MAX_FRAME_SIZE bytes of RAM.

module = USBD_CDC_ECM
module-str = usbd cdc_ecm
default-count = 1
source "subsys/logging/Kconfig.template.log_config"

endif
