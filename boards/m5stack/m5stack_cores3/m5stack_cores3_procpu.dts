/dts-v1/;

#include "m5stack_cores3_procpu_common.dtsi"

/ {
	model = "M5Stack CoreS3 PROCPU";
	compatible = "m5stack,cores3";

	aliases {
		accel0 = &bmi270;
		magn0 = &bmm150;
		light-sensor = &ltr553;
		prox-sensor0 = &ltr553;
	};

	chosen {
		zephyr,camera = &lcd_cam_dvp;
	};
};

&i2c0 {
	bmi270: bmi270@69 {
		compatible = "bosch,bmi270";
		reg = <0x69>;
	};

	bmm150: bmm150@10 {
		compatible = "bosch,bmm150";
		status = "okay";
		reg = <0x10>;
	};

	ltr553: ltr553@23 {
		compatible = "liteon,ltr553";
		reg = <0x23>;
		status = "okay";
	};

	gc0308: gc0308@21 {
		compatible = "galaxycore,gc0308";
		reg = <0x21>;
		reset-gpios = <&aw9523b_gpio 8 GPIO_ACTIVE_LOW>;

		port {
			gc0308_ep_out: endpoint {
				remote-endpoint-label = "dvp_ep_in";
			};
		};
	};
};

&dma {
	status = "okay";
};

&lcd_cam {
	status = "okay";
	pinctrl-0 = <&lcd_cam_default>;
	pinctrl-names = "default";
};

&lcd_cam_dvp {
	status = "okay";
	/*
	 * The GC0308 runs from its own oscillator, so CAM_CLK is not routed to
	 * any pin. The LCD_CAM block still needs a valid clock divider.
	 */
	cam-clk = <20000000>;
	source = <&gc0308>;

	port {
		dvp_ep_in: endpoint {
			remote-endpoint-label = "gc0308_ep_out";
		};
	};
};

&regulator {
	vddcam_3v3: ALDO3 {
		regulator-min-microvolt = <3000000>;
		/* regulator-init-microvolt = <3300000>; */
		regulator-max-microvolt = <3500000>;
		regulator-boot-on;
		status = "okay";
	};

	avdd: BLDO1 {
		regulator-min-microvolt = <2700000>;
		/* regulator-init-microvolt = <2800000>; */
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		status = "okay";
	};
};

/* Camera core supply */
&dvdd {
	regulator-boot-on;
};
