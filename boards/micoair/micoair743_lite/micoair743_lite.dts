/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743vitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/sensor/icm45686.h>

/ {
	model = "MicoAir743-Lite flight controller";
	compatible = "micoair,micoair743-lite";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &dtcm;
	};

	leds {
		compatible = "gpio-leds";

		red_led: led_0 {
			gpios = <&gpioe 3 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};

		green_led: led_1 {
			gpios = <&gpioe 2 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};

		blue_led: led_2 {
			gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
			label = "Blue LED";
		};
	};

	aliases {
		led0 = &blue_led;
		led1 = &green_led;
		led2 = &red_led;
		accel0 = &icm45686;
		sdhc0 = &sdmmc1;
		watchdog0 = &iwdg;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

/* SYSCLK = 480 MHz, PLL1_Q = 192 MHz (SPI1/2/3 kernel clock) */
&pll {
	div-m = <2>;
	mul-n = <240>;
	div-p = <2>;
	div-q = <5>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

/* PLL2_R = 48 MHz (SDMMC kernel clock) */
&pll2 {
	div-m = <2>;
	mul-n = <120>;
	div-p = <2>;
	div-q = <4>;
	div-r = <10>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&pwr {
	power-supply = "ldo";
};

/* TELEM1 */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* HD VTX (DisplayPort) */
&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* GPS */
&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* TELEM2 */
&uart4 {
	pinctrl-0 = <&uart4_tx_pa0 &uart4_rx_pa1>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart5 {
	pinctrl-0 = <&uart5_tx_pb6 &uart5_rx_pb5>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* RC input */
&usart6 {
	pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* ESC telemetry */
&uart7 {
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* On-board Bluetooth module */
&uart8 {
	pinctrl-0 = <&uart8_tx_pe1 &uart8_rx_pe0>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* External I2C connector */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

/* On-board SPA06 barometer at address 0x77, data ready on PD0 */
&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

&spi3 {
	pinctrl-0 = <&spi3_sck_pb3 &spi3_miso_pb4 &spi3_mosi_pd6>;
	pinctrl-names = "default";
	cs-gpios = <&gpiod 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	icm45686: icm45686@0 {
		compatible = "invensense,icm45686";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		int-gpios = <&gpiod 5 GPIO_ACTIVE_HIGH>;
		accel-pwr-mode = <ICM45686_DT_ACCEL_LN>;
		accel-fs = <ICM45686_DT_ACCEL_FS_16>;
		accel-odr = <ICM45686_DT_ACCEL_ODR_1600>;
		gyro-pwr-mode = <ICM45686_DT_GYRO_LN>;
		gyro-fs = <ICM45686_DT_GYRO_FS_2000>;
		gyro-odr = <ICM45686_DT_GYRO_ODR_1600>;
	};
};

&sdmmc1 {
	clocks = <&rcc STM32_CLOCK(AHB3, 16)>,
		 <&rcc STM32_SRC_PLL2_R SDMMC_SEL(1)>;
	pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
		     &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
		     &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
	pinctrl-names = "default";
	disk-name = "SD";
	status = "okay";
};

/*
 * Motor/servo outputs. All timers are clocked at 240 MHz; a prescaler of 239
 * gives a 1 MHz counter clock, suitable for standard servo and ESC PWM.
 */

/* M1-M4 */
&timers1 {
	st,prescaler = <239>;
	status = "okay";

	pwm1: pwm {
		pinctrl-0 = <&tim1_ch1_pe9 &tim1_ch2_pe11 &tim1_ch3_pe13 &tim1_ch4_pe14>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/* M5-M8 */
&timers3 {
	st,prescaler = <239>;
	status = "okay";

	pwm3: pwm {
		pinctrl-0 = <&tim3_ch1_pa6 &tim3_ch2_pa7 &tim3_ch3_pb0 &tim3_ch4_pb1>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/* M11, M12 and LED pad (M15) */
&timers4 {
	st,prescaler = <239>;
	status = "okay";

	pwm4: pwm {
		pinctrl-0 = <&tim4_ch1_pd12 &tim4_ch2_pd13 &tim4_ch3_pd14>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/* M13, M14 */
&timers12 {
	st,prescaler = <239>;
	status = "okay";

	pwm12: pwm {
		pinctrl-0 = <&tim12_ch1_pb14 &tim12_ch2_pb15>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/* M9, M10 */
&timers15 {
	st,prescaler = <239>;
	status = "okay";

	pwm15: pwm {
		pinctrl-0 = <&tim15_ch1_pe5 &tim15_ch2_pe6>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&adc12_common {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

/* Battery voltage (PC0, INP10) and current (PC1, INP11) sense */
&adc1 {
	pinctrl-0 = <&adc1_inp10_pc0 &adc1_inp11_pc1>;
	pinctrl-names = "default";
	status = "okay";
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

#include <../boards/common/usb/cdc_acm_serial.dtsi>

&rng {
	status = "okay";
};

&backup_sram {
	status = "okay";
};

&iwdg1 {
	status = "okay";
};
