zephyr-module = HAL_INTEL
zephyr-module-str = hal_intel
source "modules/Kconfig.template.module"

config INTEL_HAL
	bool
	select ZEPHYR_HAL_INTEL_MODULE_ACTIVE
	help
	  Build the Intel HAL module during build process.
	  This is selected by the ARCH kconfig automatically.
