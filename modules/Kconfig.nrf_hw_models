# BabbleSim nRF hardware models configuration

# SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
# SPDX-License-Identifier: Apache-2.0

zephyr-module = NRF_HW_MODELS
zephyr-module-str = nrf_hw_models
source "modules/Kconfig.template.module"

config ZEPHYR_NRF_HW_MODELS_MODULE_ACTIVE
	depends on ZEPHYR_NRF_HW_MODELS_MODULE
	select ZEPHYR_HAL_NORDIC_MODULE_ACTIVE
	help
	  Simulated nRF peripherals for the BabbleSim boards. The models are
	  built against the nRF HAL, which the module.yml also records.
