zephyr-module = ATMEL
zephyr-module-str = atmel
source "modules/Kconfig.template.module"

config ASF
	bool
	select HAS_CMSIS_CORE
	depends on SOC_FAMILY_ATMEL_SAM || SOC_FAMILY_ATMEL_SAM0
	select ZEPHYR_ATMEL_MODULE_ACTIVE

config ATMEL_WINC1500
	bool
	select ZEPHYR_ATMEL_MODULE_ACTIVE
