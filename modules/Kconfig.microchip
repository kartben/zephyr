# Microchip MEC HAL drivers configuration

# SPDX-License-Identifier: Apache-2.0

zephyr-module = HAL_MICROCHIP
zephyr-module-str = hal_microchip
source "modules/Kconfig.template.module"

config HAS_MEC_HAL
	bool "Microchip MEC HAL drivers support"
	select ZEPHYR_HAL_MICROCHIP_MODULE_ACTIVE

config HAS_MPFS_HAL
	bool "Microchip MPFS HAL drivers support"
	select ZEPHYR_HAL_MICROCHIP_MODULE_ACTIVE

config HAS_MEC5_HAL
	bool "Microchip MEC5 HAL drivers support"
	select ZEPHYR_HAL_MICROCHIP_MODULE_ACTIVE

config MICROCHIP_PIC32C
	bool
	select ZEPHYR_HAL_MICROCHIP_MODULE_ACTIVE

config MICROCHIP_SAM
	bool
	select ZEPHYR_HAL_MICROCHIP_MODULE_ACTIVE
